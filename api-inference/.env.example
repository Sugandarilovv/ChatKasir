# Salin file ini ke .env lalu isi nilainya
# cp .env.example .env

APP_NAME="AI2 API - ChatKasir"
APP_VERSION="1.0.0"
DEBUG=false

# !! Ganti dengan secret yang kuat di production !!
API_KEY=changeme

# Path ke model Keras (.keras) dari AI-1 (Rifan)
MODEL_PATH=models/chatkasir_model.keras

# Path ke tokenizer JSON yang disimpan bersama model
TOKENIZER_PATH=models/tokenizer.json

# Panjang sequence maksimum — harus sama dengan nilai saat training
MAX_SEQUENCE_LEN=128

# Path ke kamus slang dari DS-1 (Faradi), relatif dari root api-inference
SLANG_DICT_PATH=data/final/slang_utama.csv

GDRIVE_MODEL_URL=https://drive.google.com/uc?id=1NgbF_aslZebTiCyVW3No3U2ysH1NmDye
GDRIVE_TOKENIZER_URL=https://drive.google.com/uc?id=1i1TIsmeAI3EsVawzqmdZRQmCr3gtBhOG
GDRIVE_SLANG_URL=https://drive.google.com/uc?id=1G14C1qcqOp06Xs1HFiorE3Us_LLtaBs7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Ganti dengan domain frontend production (FS-1 Alfan)
# Contoh: ALLOWED_ORIGINS=["https://chatkasir.netlify.app"]
ALLOWED_ORIGINS=["*"]

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false