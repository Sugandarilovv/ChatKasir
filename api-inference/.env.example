# =============================================================================
# .env.example — ChatKasir AI-2 Inference API
# =============================================================================


# -----------------------------------------------------------------------------
# APP — Metadata aplikasi
# -----------------------------------------------------------------------------

APP_NAME=AI2 API - ChatKasir
APP_VERSION=2.0

# Port server. Default 7860 untuk Hugging Face Spaces, 8000 untuk lokal.
PORT=8000

# Mode debug. Jika true, autentikasi API key dinonaktifkan.
# JANGAN set true di production!
DEBUG=false


# -----------------------------------------------------------------------------
# SECURITY — Autentikasi
# -----------------------------------------------------------------------------

# API key untuk header X-API-Key. Wajib diganti sebelum deploy!
# Gunakan string acak yang kuat, minimal 32 karakter.
# Contoh generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme


# -----------------------------------------------------------------------------
# MODEL — Path file lokal (hasil download dari Google Drive)
# -----------------------------------------------------------------------------
# tf.keras.load_model() dan Tokenizer.from_file() hanya menerima path lokal.
# File akan diunduh otomatis oleh download_assets() saat server pertama start.

MODEL_PATH=models/model.keras
TOKENIZER_PATH=models/tokenizer.json

# Harus sama persis dengan nilai MAX_SEQUENCE_LEN saat training model AI-1.
MAX_SEQUENCE_LEN=128


# -----------------------------------------------------------------------------
# DATA — Kamus slang
# -----------------------------------------------------------------------------

# Path ke file CSV kamus slang (format header: slang,baku).
SLANG_DICT_PATH=data/final/slang_utama.csv


# -----------------------------------------------------------------------------
# GOOGLE DRIVE — URL auto-download aset model
# -----------------------------------------------------------------------------
# Format URL: https://drive.google.com/uc?id=<FILE_ID>
# Pastikan file di Google Drive sudah disetel ke "Anyone with the link can view".

GDRIVE_MODEL_URL=https://drive.google.com/uc?id=1xdVp5x48D-3WXhofRxUmjl6SRYh6EDyz
GDRIVE_TOKENIZER_URL=https://drive.google.com/uc?id=1kkwRYlbHFDGXzVPMiYNx-j1Ktjv0wNHM
GDRIVE_SLANG_URL=https://drive.google.com/uc?id=1Ov6cFYB_7J0lGfVYdvm7lByTI0-V36hI


# -----------------------------------------------------------------------------
# CORS — Cross-Origin Resource Sharing
# -----------------------------------------------------------------------------
# Daftar origin yang diizinkan, dipisahkan koma (format JSON list).
# Untuk development: ["*"]
# Untuk production: ganti dengan domain spesifik backend kamu.
# Contoh: ["https://dashboard.chatkasir.com","https://api.chatkasir.com"]
ALLOWED_ORIGINS=["*"]
